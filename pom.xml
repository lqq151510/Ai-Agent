<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.agent</groupId>
    <artifactId>ai-agent-mvp</artifactId>
    <version>0.1.0-beta.2</version>
    <packaging>pom</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.proc>full</maven.compiler.proc>
        <lombok.version>1.18.42</lombok.version>
    </properties>

    <modules>
        <module>backend</module>
        <module>bug-sentinel-starter</module>
    </modules>

    <!--
        Legacy profile：包含未进入 Knowledge Desk 默认产品路径的 agent-* 微服务与公共模块。
        这些模块使用 Java 25 编译，且依赖未部署的 Kafka/Milvus 基础设施，默认不参与构建。
        如需构建：mvn -Plegacy verify
    -->
    <profiles>
        <profile>
            <id>legacy</id>
            <modules>
                <module>agent-common</module>
                <module>agent-gateway</module>
                <module>agent-router</module>
                <module>agent-retrieval</module>
                <module>agent-generation</module>
                <module>agent-reflection</module>
            </modules>
        </profile>
    </profiles>
</project>
