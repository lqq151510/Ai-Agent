<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.agent</groupId>
    <artifactId>ai-agent-mvp</artifactId>
    <version>0.1.0-beta.3</version>
    <packaging>pom</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.proc>full</maven.compiler.proc>
        <lombok.version>1.18.42</lombok.version>
    </properties>

    <modules>
        <module>backend</module>
        <module>bug-sentinel-starter</module>
    </modules>

    <!--
        Legacy agent-* 微服务已归档到 legacy/ 目录，不再作为根 reactor 的模块或 profile。
        归档说明与构建方式见 legacy/README.md：
            mvn -f legacy/pom.xml -DskipTests package
    -->
</project>
