@startuml
left to right direction
actor "Web 用户" as WebUser
actor "CLI 用户" as CliUser
actor "模型服务" as Model

rectangle "Agent 对话子系统" {
  usecase "同步对话\nPOST /api/agent/chat" as UC1
  usecase "流式对话\nPOST /api/agent/chat/stream" as UC2
  usecase "SSE 心跳保活" as UC3
  usecase "聊天限流" as UC4
  usecase "模型路由\n(OpenAI/Ollama)" as UC5
  usecase "消息持久化" as UC6
}

WebUser --> UC1
WebUser --> UC2
CliUser --> UC1
CliUser --> UC2
Model --> UC5
UC2 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC2 ..> UC4 : <<include>>
UC1 ..> UC5 : <<include>>
UC2 ..> UC5 : <<include>>
UC1 ..> UC6 : <<include>>
UC2 ..> UC6 : <<include>>
@enduml
