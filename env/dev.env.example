# ---- Image / ports ----
APP_IMAGE_TAG=latest
BACKEND_IMAGE_REPO=ai-agent-backend
WEB_IMAGE_REPO=ai-agent-web
BACKEND_PORT=8080
WEB_PORT=8088
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- Database / cache ----
POSTGRES_DB=ai_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
REDIS_USERNAME=
REDIS_PASSWORD=

# ---- App runtime ----
BUG_SENTINEL_ENABLED=false
BUG_SENTINEL_TOKEN=
BUG_SENTINEL_OWNER_USER_ID=
JWT_SECRET=replace-with-at-least-32-chars
SECURITY_DB_ENCRYPTION_KEY=replace-with-at-least-32-chars
# Leave empty unless rotating from a previous database encryption key.
SECURITY_DB_LEGACY_ENCRYPTION_KEY=
WORKSPACE_ROOT=/app/workspace
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# ---- Model provider ----
MODEL_PROVIDER=OPENAI
OPENAI_BASE_URL=http://host.docker.internal:18081/v1
OPENAI_API_KEY=replace-with-lm-studio-or-openai-key
OPENAI_MODEL=qwen/qwen3.5-9b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.6:latest

# ---- Timeout / retry / startup ----
MODEL_CONNECT_TIMEOUT_MS=5000
MODEL_READ_TIMEOUT_MS=45000
MODEL_TOTAL_TIMEOUT_MS=300000
MODEL_IDEMPOTENT_RETRIES=1
STARTUP_VALIDATION_FAIL_FAST=false
MODEL_PROBE_TIMEOUT_MS=3000
MODEL_PROBE_RETRIES=1

# ---- Rate limit ----
LOGIN_RATE_LIMIT_PER_MIN=20
CHAT_RATE_LIMIT_PER_MIN=60
CHAT_PREMIUM_RATE_LIMIT_PER_MIN=120
CHAT_PREMIUM_EMAIL_SUFFIXES=

# ---- Desktop local runtime (optional) ----
DESKTOP_BACKEND_READY_TIMEOUT_MS=60000
DESKTOP_RATE_LIMITER_IDLE_TTL_MINUTES=2
DESKTOP_RATE_LIMITER_MAX_KEYS=10000
DESKTOP_SESSION_CACHE_TTL_MINUTES=5
DESKTOP_SESSION_CACHE_MAX_SESSIONS=1000
DESKTOP_DB_MAX_POOL_SIZE=4
DESKTOP_DB_MIN_IDLE=1
DESKTOP_DB_CONNECTION_TIMEOUT_MS=5000
LOG_MAX_FILE_SIZE=10MB
LOG_MAX_HISTORY=5

# ---- Web build ----
# Empty means same-origin /api via nginx reverse proxy.
VITE_API_BASE=

# ---- Smoke / report artifacts ----
SMOKE_REPORT_WINDOW_HOURS=24
SMOKE_RENDER_PDF=false
SMOKE_ARTIFACTS_DIR=
SMOKE_USE_OPENAI_MOCK=true
SMOKE_ENABLE_LEGACY=false
SMOKE_MOCK_BASE_URL=
SMOKE_MOCK_BIND_HOST=0.0.0.0
SMOKE_MOCK_STARTUP_TIMEOUT_SECONDS=10
TECTONIC_BIN=
