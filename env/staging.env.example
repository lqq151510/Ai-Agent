APP_IMAGE_TAG=latest
BACKEND_IMAGE_REPO=registry.example.com/ai-agent/backend
WEB_IMAGE_REPO=registry.example.com/ai-agent/web
BACKEND_PORT=18080
WEB_PORT=18088
POSTGRES_PORT=15432
REDIS_PORT=16379

POSTGRES_DB=ai_agent
POSTGRES_USER=ai_agent
POSTGRES_PASSWORD=replace-staging-db-password
REDIS_USERNAME=
REDIS_PASSWORD=replace-staging-redis-password

JWT_SECRET=replace-staging-jwt-secret-32chars-min
WORKSPACE_ROOT=/app/workspace
CORS_ALLOWED_ORIGINS=https://staging.example.com

MODEL_PROVIDER=OPENAI
OPENAI_BASE_URL=https://lmstudio-or-openai-proxy.example.com/v1
OPENAI_API_KEY=inject-via-runtime-secret
OPENAI_MODEL=qwen/qwen3.5-9b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.6:latest

MODEL_CONNECT_TIMEOUT_MS=5000
MODEL_READ_TIMEOUT_MS=45000
MODEL_TOTAL_TIMEOUT_MS=300000
MODEL_IDEMPOTENT_RETRIES=1
STARTUP_VALIDATION_FAIL_FAST=false
MODEL_PROBE_TIMEOUT_MS=3000
MODEL_PROBE_RETRIES=2

LOGIN_RATE_LIMIT_PER_MIN=30
CHAT_RATE_LIMIT_PER_MIN=80
CHAT_PREMIUM_RATE_LIMIT_PER_MIN=160
CHAT_PREMIUM_EMAIL_SUFFIXES=@yourcompany.com

DESKTOP_BACKEND_READY_TIMEOUT_MS=60000
DESKTOP_RATE_LIMITER_IDLE_TTL_MINUTES=2
DESKTOP_RATE_LIMITER_MAX_KEYS=10000
DESKTOP_SESSION_CACHE_TTL_MINUTES=5
DESKTOP_SESSION_CACHE_MAX_SESSIONS=1000
DESKTOP_DB_MAX_POOL_SIZE=4
DESKTOP_DB_MIN_IDLE=1
DESKTOP_DB_CONNECTION_TIMEOUT_MS=5000
LOG_MAX_FILE_SIZE=10MB
LOG_MAX_HISTORY=5

VITE_API_BASE=

SMOKE_REPORT_WINDOW_HOURS=24
SMOKE_RENDER_PDF=false
SMOKE_ARTIFACTS_DIR=
TECTONIC_BIN=
