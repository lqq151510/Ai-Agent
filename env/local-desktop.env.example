# Copy to env/local-desktop.env, replace the two persistent values, then keep
# that ignored local file private. Generate each value once with: openssl rand -base64 48
JWT_SECRET=replace-with-a-persistent-random-value-at-least-32-characters
SECURITY_DB_ENCRYPTION_KEY=replace-with-a-persistent-random-value-at-least-32-characters

APP_DATA_DIR=$HOME/.ai-agent-desktop-dev
MODEL_PROVIDER=OPENAI
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=sk-local
OPENAI_MODEL=qwen/qwen3.5-9b
