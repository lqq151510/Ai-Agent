# Knowledge Desk local backend (FastAPI) — environment reference.
#
# The Electron main process owns the process lifecycle and passes these values
# in. The legacy names (APP_DATA_DIR / APP_DESKTOP_MODE / JWT_SECRET /
# SECURITY_DB_ENCRYPTION_KEY) are accepted for compatibility with the existing
# BackendManager; the KD_* names are preferred for local development.

# Directory that holds knowledge-desk.sqlite3, sources/ and logs/.
KD_DATA_DIR=/Users/you/Library/Application Support/KnowledgeDesk

# Loopback only. Never bind the desktop backend to 0.0.0.0.
KD_HOST=127.0.0.1
KD_PORT=18080

# Set to true by the desktop launcher; enables desktop runtime expectations.
KD_DESKTOP_MODE=true

# 32+ character HMAC secret for access/refresh tokens.
# When omitted a random secret is generated and persisted inside KD_DATA_DIR.
KD_JWT_SECRET=

# Key material used to encrypt stored model credentials (Fernet via HKDF/SHA-256).
# When omitted, credentials cannot be persisted and the API answers 503.
KD_DB_ENCRYPTION_KEY=

# heuristic: no configured model falls back to the deterministic local organiser
#            (the behaviour shipped in v0.1.0-beta.3).
# fail:      no configured model records a failed organise job instead.
KD_ORGANIZE_NO_MODEL=heuristic

KD_MAX_UPLOAD_BYTES=52428800
KD_LLM_TIMEOUT_SECONDS=30
KD_LOG_LEVEL=INFO
