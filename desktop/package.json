{
  "name": "ai-agent-desktop",
  "version": "0.1.0-beta.3",
  "private": true,
  "description": "AI Agent Desktop Client for Mac, Windows and Linux",
  "author": "AI Agent Team",
  "license": "UNLICENSED",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev:renderer": "cd src/renderer && npm run dev",
    "dev": "npm run build:main && electron .",
    "dev:attached": "DESKTOP_BACKEND_URL=${DESKTOP_BACKEND_URL:-http://127.0.0.1:18080} npm run dev",
    "build:main": "tsc -p tsconfig.main.json",
    "test:main": "npm run build:main && node --test test/*.test.cjs",
    "test:packaged": "npm run build && node scripts/verify-packaged-app.cjs",
    "build:renderer": "cd src/renderer && npm run build && cp -R dist/. ../../dist/renderer/",
    "build": "npm run build:main && npm run build:renderer",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "dist:mac:x64": "npm run build && electron-builder --mac --x64",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "clean": "rm -rf dist release backend-jre"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "node-gyp": "^12.2.0",
    "fast-uri": "3.1.5"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
